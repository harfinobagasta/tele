# ============================================
# TELEGRAM CLONE CHANNEL - KONFIGURASI
# ============================================
# Cara dapat API_ID & API_HASH:
#   1. Buka https://my.telegram.org
#   2. Login pakai nomor HP Telegram kamu
#   3. Klik "API development tools"
#   4. Isi form → dapat API_ID dan API_HASH

API_ID=12345678
API_HASH=your_api_hash_here

# Channel TUJUAN (channel milikmu yang akan menerima salinan)
# Bisa pakai username (tanpa @) atau channel ID (angka negatif)
# Contoh: my_channel atau -1001234567890
DEST_CHANNEL=your_channel_username

# Channel SUMBER (yang akan di-clone)
# Pisahkan dengan koma jika lebih dari satu
SOURCE_CHANNELS=pk_fns,pk_oa

# PHONE NUMBER (nomor HP akun Telegram)
PHONE_NUMBER=+628xxxxxxxxxx
